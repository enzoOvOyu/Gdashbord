# 复制为 .env 使用。所有 VITE_* 变量在构建期注入前端（见 ARCHITECTURE.md §12.7）。
# 非 VITE_ 前缀的变量仅用于 docker-compose / 后端联调，不会进入前端构建产物。

VITE_ENABLE_MOCK=true
VITE_API_BASE_URL=http://localhost:8080
VITE_DEFAULT_REGION=jp
VITE_WS_URL=
VITE_POLL_INTERVAL_MS=3000
VITE_FEATURE_STATUS_BAR=true
VITE_FEATURE_TOPOLOGY=true
VITE_THEME_DEFAULT=light
VITE_LOW_BALANCE_THRESHOLD_USD=50
VITE_MOCK_SEED=20261017
VITE_ENABLE_CONSISTENCY_CHECK=true
VITE_MOCK_FAULT=

POSTGRES_DB=runsun
POSTGRES_USER=runsun
POSTGRES_PASSWORD=runsun
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 容器出网代理：供前端容器 pnpm install 访问 npm 源。
# host.docker.internal 在容器内解析到宿主网关；端口须与你的宿主代理一致（默认 62294）。
COMPOSE_HTTP_PROXY=http://host.docker.internal:62294
COMPOSE_HTTPS_PROXY=http://host.docker.internal:62294
